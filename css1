* {
  box-sizing: border-box;
}

body {
  font-family: 'Open Sans', sans-serif;
  background: linear-gradient(120deg, #2a3f5f, #1e5f7a, #2a3f5f);
  margin: 0;
  padding: 0;
}

.flat-page header {
  min-height: 80px;
  display: flex;
}

max-width: 767px {
  .flat-page header {
    min-height: auto;
    display: initial;
  }
}

.flat-page header .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

max-width: 767px {
  .flat-page header .container {
    flex-direction: column;
    justify-content: center;
    gap: 15px;
  }
}

.flat-page header .links {
  display: flex;
  align-items: center;
}

max-width: 900px {
  .flat-page header .links {
    text-align: center;
    gap: 20px;
    margin: 0 auto;
    max-width: 520px;
  }
}

.flat-page header .links li {
  margin-left: 10px;
  color: #fff;
  cursor: pointer;
  transition: .3s;
}

max-width: 900px {
  .flat-page header .links li {
    margin-left: auto;
  }
}

.flat-page header .links li:last-child {
  border-radius: 20px;
  padding: 10px 20px;
  color: #fff;
  background-color: #ff6b6b;
}

.flat-page .content .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 140px;
  min-height: calc(100vh - 80px);
}

max-width: 767px {
  .flat-page .content .container {
    gap: 0;
    min-height: calc(100vh - 101px);
    justify-content: center;
    flex-direction: column-reverse;
  }
}

max-width: 767px {
  .flat-page .content .info {
    text-align: center;
    margin-bottom: 15px;
  }
}

.flat-page .content .info h1 {
  color: white;
  font-size: 38px;
}

.flat-page .content .info p {
  margin: 0;
  line-height: 1.6;
  font-size: 15px;
  color: white;
}

.flat-page .content .info button {
  border: 0;
  border-radius: 20px;
  padding: 12px 30px;
  margin-top: 30px;
  cursor: pointer;
  color: #fff;
  background-color: #ff6b6b;
}

.flat-page .content .image img {
  max-width: 120%;
  margin-top: 50px;
}
